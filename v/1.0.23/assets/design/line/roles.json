      "menu": ["Today", "Explained", "Impact", "The agencies", "The playbook", "Everything"],
      "firstPart": "Your three questions come first.",
      "frontParts": ["hero", "tiles", "questions", "now+unknown", "spectrum"]
    },
    "general": {
