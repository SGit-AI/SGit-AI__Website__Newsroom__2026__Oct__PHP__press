      "group": "understand", "depth": "plain",
      "readers": ["everyone", "site-owner"],
      "menu": ["Today", "Explained", "Impact", "The numbers", "Everything"],
      "firstPart": "“Does it touch you?” comes first.",
      "frontParts": ["hero", "touch+todo", "tiles", "now+unknown"]
    },
    "security": {
      "name": "Security", "as": "Security", "question": "What do we patch, block and watch?",
