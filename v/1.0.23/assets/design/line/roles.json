      "readers": ["security", "ciso", "appsec"],
      "menu": ["Today", "The playbook", "Exploitation", "Defence", "The agencies", "Everything"],
      "firstPart": "Your next three actions come first.",
      "frontParts": ["hero", "actions", "signals+advice", "spectrum", "status"]
    },
    "engineer": {
      "name": "Engineer", "as": "an Engineer", "question": "Which versions, settings and commands?",
      "group": "act", "depth": "deep",
      "readers": ["engineer", "developer"],
      "menu": ["Today", "The flaws", "The playbook", "Am I affected?", "The code", "Everything"],
