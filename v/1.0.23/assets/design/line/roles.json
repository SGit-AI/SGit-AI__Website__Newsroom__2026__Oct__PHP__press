  "emptyCells": {
    "note": "Role x depth combinations with no reader in personas.json. They still get a page: the role's parts at that depth.",
    "cells": ["exec/deep", "security/plain", "engineer/plain", "journalist/deep", "researcher/plain", "general/technical", "general/deep"]
  },
  "guesses": [
    { "source": "shared", "when": "URL carries ?as=<role or reader>", "role": "from the link", "reason": "a link shared set to this view", "lasts": "this visit, unless the reader keeps it" },
    { "source": "advisory", "when": "referrer is a government or CERT advisory (e.g. cisa.gov, ncsc.gov.uk, cert.europa.eu, cert.ssi.gouv.fr, ncsc.nl, cyber.gov.au)", "role": "security", "reason": "a government security advisory" },
    { "source": "search-version", "when": "search referrer or utm term contains a PHP version (8.x.y) or a SAPI name (fpm, mod_php)", "role": "engineer", "reason": "a search for a PHP version" },
    { "source": "archive", "when": "referrer is a mailing-list or research archive (openwall.com, seclists.org, github.com/advisories)", "role": "researcher", "reason": "a mailing-list archive" },
    { "source": "news", "when": "referrer is a news site", "role": "general", "reason": "a news article" },
    { "source": "default", "when": "nothing above applies", "role": "exec", "reason": null }
  ]
}
