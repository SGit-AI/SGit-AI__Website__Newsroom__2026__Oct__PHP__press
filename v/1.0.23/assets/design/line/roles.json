      "readers": ["researcher", "analyst"],
      "menu": ["Today", "The code", "The flaws", "Discovery", "Context", "Everything"],
      "firstPart": "The open questions come first.",
      "frontParts": ["hero", "open-questions", "bug-classes+shown", "contested", "timeline"]
