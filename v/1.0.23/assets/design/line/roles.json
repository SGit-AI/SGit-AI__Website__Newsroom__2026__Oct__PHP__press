{
  "note": "The persona model for the line. Seven roles (centres of gravity), each holding readers from data/personas.json. The role decides which parts a page shows and in what order, the menu, and what counts as news; the reader refines the answer's wording; depth decides how technical every fact is worded. Default for anyone we know nothing about: exec.",
  "default": "exec",
  "order": ["exec", "general", "security", "engineer", "journalist", "researcher", "everything"],
  "depths": {
    "plain": { "label": "Plain", "personasDepth": 1, "text": "No technical background assumed. Every term explained on first use." },
    "technical": { "label": "Technical", "personasDepth": 2, "text": "Servers, versions and patches; not the internals." },
    "deep": { "label": "Deep", "personasDepth": 3, "text": "Versions, settings, code paths and the primary records verbatim." }
  },
  "roles": {
